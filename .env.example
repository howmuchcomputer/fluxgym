# Copy to .env and fill in. .env is gitignored.
# IMPORTANT: put real secrets ONLY in .env, NEVER in this .env.example file
# (.env.example is committed to git). Leave RUNPOD_* blank to run training
# locally (default FluxGym behaviour).

# --- RunPod ---
# Your RunPod API key (https://www.runpod.io/console/user/settings).
RUNPOD_API_KEY=
# Set by `python runpod_worker/deploy.py`. When this AND RUNPOD_API_KEY are set, the
# local UI submits training to this serverless endpoint instead of running locally.
RUNPOD_ENDPOINT_ID=
# Set by deploy.py; reuse the same volume so base models download only once.
RUNPOD_NETWORK_VOLUME_ID=

# --- Docker registry (built/pushed by runpod_worker/build_and_push.sh) ---
# DOCKER_USERNAME + DOCKER_API_KEY let build_and_push.sh log in non-interactively.
# DOCKER_API_KEY is a Docker Hub access token (Account Settings > Security).
DOCKER_USERNAME=your-dockerhub-username
DOCKER_API_KEY=your-dockerhub-access-token
DOCKER_IMAGE=docker.io/your-dockerhub-username/fluxgym-runpod:latest

# --- deploy.py knobs (sensible defaults; override as needed) ---
RUNPOD_NAME=fluxgym-krea
# Must support network volumes. US-OR-1 does NOT; US-KS-2 / EU-RO-1 do.
RUNPOD_DATA_CENTER_ID=US-KS-2
RUNPOD_VOLUME_GB=100
RUNPOD_CONTAINER_DISK_GB=30
# GPU pool. AMPERE_48 = 48GB Ampere (A40/A6000), a good fit for FLUX LoRA.
RUNPOD_GPU_IDS=AMPERE_48
RUNPOD_WORKERS_MAX=1
RUNPOD_IDLE_TIMEOUT=60

# --- HuggingFace (where the trained LoRA is pushed) ---
# If HF_REPO_OWNER + HF_TOKEN are set, the worker pushes the LoRA to
# <owner>/<lora-name>. Otherwise it stays on the network volume.
HF_TOKEN=
HF_REPO_OWNER=
HF_VISIBILITY=public
