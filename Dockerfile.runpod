# RunPod serverless image for FluxGym remote training.
# Unlike the stock Dockerfile, this KEEPS sd-scripts in the image (the worker
# runs sd-scripts/flux_train_network.py at runtime and there is no bind-mount
# on serverless) and launches the training handler instead of the Gradio UI.
FROM nvidia/cuda:12.4.1-base-ubuntu22.04

RUN apt-get update -y && apt-get install -y \
    python3-pip \
    python3-dev \
    git \
    build-essential

WORKDIR /app

# Use uv for installs. Plain pip backtracks pathologically on these large
# unpinned requirement sets (35min+ stalls); uv (what the project's install.js
# uses) resolves in seconds. --system installs into the container's python.
RUN pip install --no-cache-dir uv
ENV UV_SYSTEM_PYTHON=1

# Clone Kohya sd-scripts (sd3 branch) and install its deps. KEEP the directory.
RUN git clone -b sd3 https://github.com/kohya-ss/sd-scripts && \
    uv pip install --system --no-cache -r sd-scripts/requirements.txt

# Install FluxGym app deps + the RunPod SDK.
# The worker runs handler.py (gradio-free); gradio is only needed by the local
# UI (app.py). We strip gradio/gradio_logsview here because gradio pins
# tomlkit==0.12.0 which conflicts with runpod (tomlkit>=0.12.2).
COPY ./requirements.txt ./requirements.txt
COPY ./requirements-runpod.txt ./requirements-runpod.txt
RUN grep -ivE '^(gradio_logsview|gradio)([<>=@ ]|$)' ./requirements.txt > ./requirements-worker.txt && \
    uv pip install --system --no-cache -r ./requirements-worker.txt && \
    uv pip install --system --no-cache -r ./requirements-runpod.txt

# Torch for CUDA 12.4 (override any CPU torch pulled in above).
RUN uv pip install --system --no-cache torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu124

# Copy the FluxGym application code into the repo root, then move sd-scripts in
# so it sits at /app/fluxgym/sd-scripts (where handler.py expects it).
COPY . /app/fluxgym
RUN cp -r /app/sd-scripts /app/fluxgym/sd-scripts

WORKDIR /app/fluxgym

ENV HF_HUB_ENABLE_HF_TRANSFER=1
ENV PYTHONUNBUFFERED=1

# entrypoint wires the network volume to ./models, then starts the worker.
RUN chmod +x /app/fluxgym/runpod/entrypoint.sh
ENTRYPOINT ["/app/fluxgym/runpod/entrypoint.sh"]
